from __future__ import annotations
from pathlib import Path
from forge.customization.loader import CustomizationLoader
from forge.runtime.env import ForgeEnv
from forge.runtime.reward import RewardEngine
from forge.runtime.snapshot import EnvironmentSpec
from forge.runtime.transition import TransitionEngine
from forge.runtime.verifier import VerifierEngine
from generated_envs.{{ project_name }}.initial_state import {{ project_name | pascal_case }}InitialStateFactory
{% for action in actions %}
from generated_envs.{{ project_name }}.transitions.{{ action.name }} import {{ action.name | pascal_case }}Handler
{% endfor %}
{% for task in tasks %}
from generated_envs.{{ project_name }}.verifiers.{{ task.name }} import {{ task.name | pascal_case }}Verifier
from generated_envs.{{ project_name }}.rewards.{{ task.name }} import {{ task.name | pascal_case }}Rubric
{% endfor %}


def build_{{ project_name }}_env(max_steps: int = 20) -> ForgeEnv:
    spec = EnvironmentSpec(name="{{ project_name }}", domain="{{ domain }}", max_steps=max_steps)

    te = TransitionEngine()
{% for action in actions %}
    te.register("{{ action.name }}", {{ action.name | pascal_case }}Handler())
{% endfor %}

    ve = VerifierEngine()
{% for task in tasks %}
    ve.register("{{ task.name }}", {{ task.name | pascal_case }}Verifier())
{% endfor %}

    re = RewardEngine()
{% if tasks %}
    re.set_default({{ tasks[0].name | pascal_case }}Rubric())
{% endif %}

    _pkg_dir = Path(__file__).parent
    CustomizationLoader(_pkg_dir).apply(te, ve, re)

    return ForgeEnv(
        env_spec=spec,
        initial_state_provider={{ project_name | pascal_case }}InitialStateFactory(),
        transition_engine=te,
        verifier_engine=ve,
        reward_engine=re,
    )
