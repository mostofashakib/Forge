# Copy this file to backend/.env and replace secret placeholders locally.
# Never commit backend/.env or any other real environment file.

# LLM provider
ANTHROPIC_API_KEY=your_anthropic_api_key_here
FORGE_LLM_PROVIDER=anthropic
FORGE_LLM_MODEL=claude-haiku-4-5-20251001
FORGE_LLM_MODEL_CAPABLE=claude-sonnet-4-6

# Core runtime
FORGE_DB_URL=sqlite:///./forge.db
FORGE_GENERATED_ENVS_DIR=generated_envs
FORGE_SANDBOX_LIMIT=10
FORGE_HOST=127.0.0.1
FORGE_DEBUG=
FORGE_DEV_NETWORK=false
FORGE_DISABLE_PREWARM=0
FORGE_DETERMINISM=on

# Environment generation budgets
FORGE_ENVGEN_CAPABLE_TOKENS=8192
FORGE_ENVGEN_TELEMETRY_TOKENS=32768
FORGE_ENVGEN_STANDARD_TOKENS=4096
FORGE_ENVGEN_FAST_TOKENS=2048
FORGE_ENVGEN_ACTION_TOKENS=512
FORGE_ENVGEN_CLI_TOKENS=256
FORGE_ENVGEN_GRADING_TOKENS=1024
FORGE_ENVGEN_MAX_REPAIR_ROUNDS=2
FORGE_RESEARCH_SEARCH_RESULTS=3
FORGE_RESEARCH_HTTP_TIMEOUT=8.0
FORGE_RESEARCH_DOCUMENT_CHARS=20000
FORGE_RESEARCH_SOURCE_CHARS=24000
FORGE_REVIEW_FILE_CHARS=16000
FORGE_SPECIALIST_CONTEXT_CHARS=12000
FORGE_SPECIALIST_CONTEXT_ITEMS=8
FORGE_STATE_BRIDGE_INPUT_CHARS=2000

# Container images and limits
FORGE_PYTHON_BASE_IMAGE=python:3.12-slim
FORGE_CLI_IMAGE=ubuntu:22.04
FORGE_BROWSER_IMAGE=lscr.io/linuxserver/chromium:latest
FORGE_CONTAINER_MEMORY=1g
FORGE_BROWSER_MEMORY=2g
FORGE_CLI_MEMORY=1g
FORGE_CONTAINER_NANO_CPUS=1000000000
FORGE_CONTAINER_PIDS=256

# Internal values injected into validation and generated-container processes
FORGE_ENV=development
FORGE_ENV_NAME=example
FORGE_VALIDATION_READ_ROOTS=[]
FORGE_VALIDATION_WRITE_ROOTS=[]
