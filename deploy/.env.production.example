# Every variable the production stack reads: Forge, Redis, Litestream, restic,
# the heartbeat, Caddy, Tailscale, and Healthchecks.io.
#
# Copy to deploy/.env.production (laptop) or deploy/.env.vm (VM). Both are
# gitignored. Never commit a real value. A secret left as mock_key counts as
# unset, and the API and worker refuse to start in production without it.
#
# "Fill:" says who sets each value. "agent" means generated with
# `openssl rand -hex 32` and written straight into the file.

# ---------------------------------------------------------------- deployment
FORGE_ENV=production
# laptop, vm, or restore-drill. Prefixes every backup path, so deployments never share backups.
FORGE_DEPLOY_NAME=laptop
# Image tag to run. The deploy pipeline sets it to the commit SHA.
FORGE_IMAGE_TAG=latest
# Registry path of the images. Local builds are tagged with the same name.
FORGE_IMAGE_REPO=ghcr.io/mostofashakib
# Group id that owns /var/run/docker.sock on this machine: `stat -c %g /var/run/docker.sock`.
DOCKER_GID=991
# The host browsers use to reach Forge: the tailnet name on the VM, or a test VM's address.
# CORS_ORIGINS and NEXT_PUBLIC_API_URL are https://<this>.
FORGE_PUBLIC_HOST=forge.example.ts.net
# Tailnet name of the VM, for example forge.tail1234.ts.net. Empty on a test machine,
# which skips the tailnet-only checks. Fill: H7.
FORGE_TAILNET_HOST=
# "internal" (Caddy's own CA, for a test machine) or "/certs/cert.pem /certs/key.pem" (tailscale cert, on the VM).
FORGE_TLS=internal

# ---------------------------------------------------------------- Forge
# The browser origin: https://<FORGE_PUBLIC_HOST>. NEXT_PUBLIC_API_URL is compiled into the frontend image.
CORS_ORIGINS=https://forge.example.ts.net
NEXT_PUBLIC_API_URL=https://forge.example.ts.net
FORGE_DB_URL=sqlite:////data/forge.db
FORGE_GENERATED_ENVS_DIR=/generated_envs
FORGE_SANDBOX_HOST=127.0.0.1
FORGE_SANDBOX_LIMIT=6
# Litestream's local state, watched by /api/health. Leave empty to turn the backup check off.
FORGE_LITESTREAM_DIR=/data/.forge.db-litestream
# Fill: agent. Keys PII pseudonyms. Keep it stable: changing it changes every pseudonym.
FORGE_SCRUB_KEY=mock_key

# ---------------------------------------------------------------- Redis
# Fill: agent. The api and worker reach Redis at redis://:<this>@127.0.0.1:6379/0.
FORGE_REDIS_PASSWORD=mock_key

# ---------------------------------------------------------------- LLM provider
# ollama, anthropic, openai, or gemini. Fill: H1.
FORGE_LLM_PROVIDER=ollama
FORGE_LLM_MODEL=gemma3:1b
FORGE_LLM_MODEL_CAPABLE=gemma3:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Only the key for FORGE_LLM_PROVIDER is needed. Fill: H4.
ANTHROPIC_API_KEY=mock_key
OPENAI_API_KEY=mock_key
GEMINI_API_KEY=mock_key
# GitHub repo environments only. Public read access is enough.
GITHUB_TOKEN=mock_key

# ---------------------------------------------------------------- backups
# S3-compatible bucket: Cloudflare R2, AWS S3, or Cloud Storage with HMAC keys. Fill: H2.
BACKUP_S3_ENDPOINT=mock_key
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=forge-backups
BACKUP_S3_ACCESS_KEY_ID=mock_key
BACKUP_S3_SECRET_ACCESS_KEY=mock_key
# Fill: agent. The only key to the file backups. Save a copy in a password manager (H5).
RESTIC_PASSWORD=mock_key

# ---------------------------------------------------------------- alerts
# Healthchecks.io ping URLs and a read-only API key. Fill: H3.
FORGE_HC_HEALTH_URL=mock_key
FORGE_HC_BACKUP_URL=mock_key
HC_API_KEY_READONLY=mock_key

# ---------------------------------------------------------------- VM access
# One-time Tailscale auth key, removed from the VM's copy after first use. Fill: H7.
TS_AUTHKEY=mock_key
# Only when the GHCR images are private. Fill: H8.
GHCR_READ_TOKEN=mock_key
