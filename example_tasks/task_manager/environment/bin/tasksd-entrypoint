#!/bin/sh
# Runs as root only long enough to take ownership of the socket directory, then
# drops to tasksd for the life of the process. The workspace database is never
# touched by a privileged process after this point.
set -eu
install -d -o tasksd -g tasksd -m 0755 /run/tasks
exec setpriv --reuid=tasksd --regid=tasksd --clear-groups \
     python3 -m task_sim.server \
       --db /var/lib/tasks/tasks.db \
       --snapshot /var/lib/tasks/tasks_seed_snapshot.sql
